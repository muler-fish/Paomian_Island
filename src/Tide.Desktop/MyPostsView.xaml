<UserControl x:Class="Tide.Desktop.MyPostsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Tide.Desktop" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="SentPostTemplate">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,14">
        <StackPanel>
          <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding CookieName}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Destination}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          </WrapPanel>
          <local:EmojiLabel Text="{Binding Title}" Foreground="{DynamicResource Text}" FontSize="{Binding DataContext.FontSize,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasTitle,Converter={StaticResource Visible}}"/>
          <local:EmojiLabel Text="{Binding Author}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasAuthor,Converter={StaticResource Visible}}"/>
          <local:PostPreview Html="{Binding Html}" FontSize="{Binding DataContext.FontSize,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          <TextBlock Text="含附图" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" Visibility="{Binding HasImage,Converter={StaticResource Visible}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="查看全文" Command="{Binding DataContext.ViewCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="打开原串" Margin="8,0,0,0" Visibility="{Binding CanOpen,Converter={StaticResource Visible}}" Command="{Binding DataContext.OpenCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="查找串号" Margin="8,0,0,0" Visibility="{Binding CanFind,Converter={StaticResource Visible}}" IsEnabled="{Binding LookupEnabled}" Command="{Binding DataContext.FindCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="RecordList" TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ItemTemplate" Value="{StaticResource SentPostTemplate}"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="24,0,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="本机发送记录" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <ui:Button Grid.Column="1" Style="{StaticResource RefreshIconButton}" Command="{Binding ReloadCommand}" ToolTip="重新读取本机记录" AutomationProperties.Name="刷新我的发言"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16"/></ui:Button>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasError,Converter={StaticResource Visible}}"/>
    <TabControl Grid.Row="2" x:Name="SpeechTabs">
      <TabItem Header="我的主题"><Grid>
        <ListBox ItemsSource="{Binding Threads}" Style="{StaticResource RecordList}" AutomationProperties.Name="我的主题记录"/>
        <TextBlock Text="暂无本机主题记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="{Binding EmptyThreads,Converter={StaticResource Visible}}"/>
      </Grid></TabItem>
      <TabItem Header="我的回复"><Grid>
        <ListBox ItemsSource="{Binding Replies}" Style="{StaticResource RecordList}" AutomationProperties.Name="我的回复记录"/>
        <TextBlock Text="暂无本机回复记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="{Binding EmptyReplies,Converter={StaticResource Visible}}"/>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
