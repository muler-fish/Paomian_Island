<UserControl x:Class="Paomian.Desktop.ComposerImageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Center">
    <Grid x:Name="Tile" Width="104" Height="76" Background="Transparent" ClipToBounds="True">
        <Border CornerRadius="5" Background="{DynamicResource Canvas}"/>
        <Image x:Name="Photo" Margin="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.Name="附图缩略图">
            <Image.Clip><RectangleGeometry Rect="0,0,100,72" RadiusX="4" RadiusY="4"/></Image.Clip>
        </Image>
        <ui:SymbolIcon x:Name="Placeholder" Symbol="Image24" FontSize="22" Foreground="{DynamicResource Muted}"/>
        <Border x:Name="Shade" CornerRadius="5" Background="{DynamicResource Scrim}" Opacity="0" IsHitTestVisible="False"/>
        <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Line}" IsHitTestVisible="False"/>
        <Button x:Name="Remove" ToolTip="移除图片" AutomationProperties.Name="移除图片" Padding="0"
                Width="32" Height="32" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Opacity="0" IsHitTestVisible="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" x:Name="Disk">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="{DynamicResource Text}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disk" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Disk" Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disk" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Disk" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
